%% timeline.mmd: lifecycle over time, ordered phases without durations.
%% - Use gantt.mmd instead when durations or overlap matter.
%% - Section per phase; events are short phrases.
%% - No diff styling (timeline has no classDef); prefix labels with markers instead.
timeline
  section Create
    (1) admission : (2) defaults applied
  section Run
    (3) ready : + (4) warmup window
  section Delete
    (5) preStop : (6) SIGTERM
