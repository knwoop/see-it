%% er.mmd: data shape and relations.
%% - Entities in UPPER_SNAKE or the source's own table names.
%% - Attributes: type and name only; PK/FK/UK markers allowed.
%% - Relationship labels: short verb phrases.
%% - Numbering: no node numbers. Put the source list in entity order instead.
%% - Diff styling: classDef lines from common.mmd, then "class ENTITY added".
%%   Changed attributes: prefix the attribute comment with the marker, e.g. "~ nullable".
erDiagram
  CUSTOMER ||--o{ ORDER : places
  ORDER ||--|{ LINE_ITEM : contains
  CUSTOMER {
    string id PK
    string email UK
  }
  ORDER {
    string id PK
    string customer_id FK
    string status "~ enum widened"
  }
  LINE_ITEM {
    string order_id FK
    int quantity
  }

  classDef added fill:#dafbe1,stroke:#1a7f37,stroke-width:2px,color:#1f2328
  classDef changed fill:#fff8c5,stroke:#9a6700,stroke-width:2px,color:#1f2328
  class ORDER changed
